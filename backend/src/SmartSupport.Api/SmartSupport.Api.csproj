<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- API layer: REST controllers, SignalR hub, JWT auth, OpenAPI docs. -->
  <ItemGroup>
    <ProjectReference Include="..\SmartSupport.Infrastructure\SmartSupport.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- pin patched versions of transitive packages flagged by NuGet audit -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.*" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
  </ItemGroup>

</Project>
