# Copy to .env and fill in. Never commit the real .env file.

# OpenAI key from https://platform.openai.com/api-keys
# Used for both the chat model and embeddings.
OPENAI_API_KEY=

# Optional: change the model (default gpt-4.1-mini)
# AI_CHAT_MODEL=gpt-4o-mini

# Optional: another OpenAI-compatible provider for chat, e.g. Groq
# AI_CHAT_ENDPOINT=https://api.groq.com/openai/v1
# AI_CHAT_MODEL=llama-3.3-70b-versatile

# Secret used to sign login tokens (at least 32 characters)
JWT_KEY=change-this-demo-key-0123456789-abcdefghijklmnop
