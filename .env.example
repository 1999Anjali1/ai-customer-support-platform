# Copy to .env and fill in. Never commit the real .env file.

# Free Google Gemini key (no credit card): https://aistudio.google.com/apikey
# Used for both the chat model and embeddings.
GEMINI_API_KEY=

# Optional: change the model (default gemini-3.1-flash-lite)
# AI_CHAT_MODEL=gemini-3.5-flash

# Optional: use another OpenAI-compatible provider instead (e.g. OpenAI, Azure OpenAI, Groq)
# AI_CHAT_ENDPOINT=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4.1-mini
# EMBEDDINGS_ENDPOINT=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# GEMINI_API_KEY=<that provider's key>

# Secret used to sign login tokens (at least 32 characters)
JWT_KEY=change-this-demo-key-0123456789-abcdefghijklmnop
